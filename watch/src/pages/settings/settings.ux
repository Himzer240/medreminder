<template>
  <div class="page" style="background-color: {{pageBg}}">
    <div class="hd">
      <div class="back" onclick="back">
        <text class="backTx">返回</text>
      </div>
      <text class="hdTitle">设置</text>
    </div>

    <div class="card" style="background-color: {{cardBg}}">
      <text class="cardTitle">震动提醒</text>
      <div class="switch {{vibOn ? 'switchOn' : ''}}" onclick="toggleVib">
        <text class="switchTx">{{vibTx}}</text>
      </div>
    </div>

    <div class="syncCard" style="background-color: {{accentColor}}" onclick="pushNow">
      <text class="syncTx">同步到手机端</text>
    </div>


    <div class="syncCard" style="background-color: {{accentColor}}" onclick="goPlans">
      <text class="syncTx">管理每个计划的次数</text>
    </div>

    <div class="card" style="background-color: {{cardBg}}">
      <text class="cardTitle">今日打卡次数</text>
      <div class="miniBtn" onclick="resetDone">
        <text class="miniTx">清零</text>
      </div>
    </div>

    <div class="about">
      <text class="aboutTitle">吃药提醒 · 手表端</text>
      <text class="aboutLine">版本 1.20　　作者 萧茂蜜呀</text>
      <text class="aboutLine">B 站同名 · 手机端负责提醒，表上负责看和打卡</text>
    </div>

    <div class="reset" onclick="resetAll">
      <text class="resetTx">恢复默认计划</text>
    </div>

    <text class="hint">时间点只能在手机端改，表上改不了</text>

    <div class="toast" if="{{toastOn}}">
      <text class="toastText">{{tx}}</text>
    </div>
  </div>
</template>

<style>
