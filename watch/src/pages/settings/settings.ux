    background-color: #1098AD;
  }

  .syncCard {
    height: 62px;
    margin-top: 10px;
    background-color: #1098AD;
    border-radius: 18px;
    justify-content: center;
    align-items: center;
  }

  .syncTx {
    font-size: 19px;
    color: #FFFFFF;
    font-weight: bold;
  }

  .miniBtn {
    height: 34px;
    padding: 0 18px;
    border-radius: 17px;
    border-width: 1px;
    border-color: #D9534F;
    justify-content: center;
    align-items: center;
  }

  .miniTx {
    font-size: 15px;
    color: #D9534F;
  }

  .about {
    margin-top: 12px;
