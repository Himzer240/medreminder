    text-align: center;
  }

  .reset {
    height: 44px;
    border-width: 2px;
    border-color: #C0392B;
    border-radius: 22px;
    margin-top: 12px;
    justify-content: center;
    align-items: center;
  }

  .resetTx {
    font-size: 16px;
    color: #E74C3C;
  }

  .hint {
    font-size: 14px;
    color: #55636B;
    margin-top: 8px;
    text-align: center;
  }
</style>

<script>
import storage from '@system.storage'
import vibrator from '@system.vibrator'
import router from '@system.router'
import interconnect from '@system.interconnect'

const PLAN_KEY = 'mw_plans'
const VIB_KEY = 'mw_vib'

const DEFAULT_PLANS = []

function timeToMin(t) {
  const a = t.split(':')
  return parseInt(a[0], 10) * 60 + parseInt(a[1], 10)
}

function minToTime(m) {
  if (m > 1435) {
    m = 1435
  }
  return pad2(Math.floor(m / 60)) + ':' + pad2(m % 60)
}

export default {
  data: {
    accentColor: '#1098AD',
    pageBg: '#0E1214',
    cardBg: '#1C262C',
    innerBg: '#16232A',
    rowBg: '#141A1E',
    vibOn: true,
    vibTx: '开',
    toastOn: false,
    tx: '',
    has0: false,
    has1: false,
    has2: false,
    q0n: '', q0t: '', q0c: '',
    q1n: '', q1t: '', q1c: '',
    q2n: '', q2t: '', q2c: ''
  },

  loadTheme() {
    const that = this
    try {
      storage.get({
        key: 'mw_accent',
        success: function (v) {
          if (v && v.length >= 7) {
            that.applyTheme(v)
          }
        },
        fail: function () {
        }
      })
    } catch (e) {
    }
  },

  applyTheme(hex) {
    const r = parseInt(hex.substr(1, 2), 16)
    const g = parseInt(hex.substr(3, 2), 16)
    const b = parseInt(hex.substr(5, 2), 16)
    if (isNaN(r) || isNaN(g) || isNaN(b)) {
      return
    }
    const pad = function (v) {
      const t = '' + Math.round(v).toString(16)
      return t.length < 2 ? '0' + t : t
    }
    const shade = function (f) {
      const c = function (v) {
        const x = v * f
        return x > 255 ? 255 : x
      }
      return '#' + pad(c(r)) + pad(c(g)) + pad(c(b))
    }
    this.accentColor = hex
    this.pageBg = shade(0.16)
    this.cardBg = shade(0.30)
    this.innerBg = shade(0.26)
    this.rowBg = shade(0.22)
  },

  onInit() {
    this.loadTheme()
    this.rawPlans = []
    try {
      this.conn = interconnect.instance()
    } catch (e) {
      this.conn = null
    }
    this.toastOn = false
    this.tx = ''
    this.load()
  },

  load() {
    const that = this
    storage.get({
      key: VIB_KEY,
      success: function (v) {
        that.vibOn = v !== '0'
        that.vibTx = that.vibOn ? '开' : '关'
      },
      fail: function () {
        that.vibOn = true
        that.vibTx = '开'
      }
    })
    storage.get({
      key: PLAN_KEY,
      success: function (v) {
        let plans = null
        try {
          plans = JSON.parse(v)
        } catch (e) {
          plans = null
        }
        if (!plans || !plans.length) {
          plans = DEFAULT_PLANS
        }
        that.rawPlans = plans
        that.render()
      },
      fail: function () {
        that.rawPlans = DEFAULT_PLANS
        that.render()
      }
    })
  },

  render() {
    this.has0 = this.rawPlans.length > 0
    this.has1 = this.rawPlans.length > 1
    this.has2 = this.rawPlans.length > 2
    if (this.has0) {
      this.q0n = this.rawPlans[0].name
      this.q0t = (this.rawPlans[0].times || []).join(' / ')
      this.q0c = (this.rawPlans[0].times || []).length
    }
    if (this.has1) {
      this.q1n = this.rawPlans[1].name
      this.q1t = (this.rawPlans[1].times || []).join(' / ')
      this.q1c = (this.rawPlans[1].times || []).length
    }
    if (this.has2) {
      this.q2n = this.rawPlans[2].name
      this.q2t = (this.rawPlans[2].times || []).join(' / ')
      this.q2c = (this.rawPlans[2].times || []).length
    }
  },

  save() {
    storage.set({
      key: PLAN_KEY,
      value: JSON.stringify(this.rawPlans)
    })
  },

  back() {
    router.back()
  },

  goPlans() {
    router.push({ uri: '/pages/plans' })
  },

  pushNow() {
    const that = this
    if (!this.conn) {
      this.tx = '手表和手机没有连上'
      this.toastOn = true
      setTimeout(function () { that.toastOn = false }, 1600)
      return
    }
    storage.get({
      key: 'mw_done',
      success: function (value) {
        let done = null
        try {
          done = JSON.parse(value)
        } catch (e) {
          done = null
        }
        const counts = done && done.counts ? done.counts : {}
        const list = []
        for (let i = 0; i < that.rawPlans.length; i++) {
          const id = that.rawPlans[i].id
          const c = counts[id]
          list.push({ id: id, count: typeof c === 'number' ? c : 0 })
        }
        try {
          that.conn.send({
            data: { tag: 'sync', counts: list },
            success: function () {},
            fail: function () {}
          })
        } catch (e) {
          console.log('push fail ' + e)
        }
        that.tx = '已把今天的次数发给手机'
        that.toastOn = true
        setTimeout(function () { that.toastOn = false }, 1600)
        vibrator.vibrate({ mode: 'short' })
      }
    })
  },

  resetDone() {
    storage.set({ key: 'mw_done', value: '{"date":"","counts":{}}' })
    this.tx = '今日打卡已清零'
    this.toastOn = true
    const that = this
    setTimeout(function () {
      that.toastOn = false
    }, 1600)
    vibrator.vibrate({ mode: 'short' })
  },

  toggleVib() {
    this.vibOn = !this.vibOn
    this.vibTx = this.vibOn ? '开' : '关'
    globalThis.__vibOn = this.vibOn
    storage.set({ key: VIB_KEY, value: this.vibOn ? '1' : '0' })
    if (this.vibOn) {
      vibrator.vibrate({ mode: 'short' })
    }
  },

  addTime(index) {
    const plan = this.rawPlans[index]
    if (!plan) {
      return
    }
    const times = plan.times || []
    if (times.length >= 12) {
      this.tx = '最多 12 次，请到手机端调整'
      this.toastOn = true
      const that = this
      setTimeout(function () { that.toastOn = false }, 1600)
      return
    }
    let t = times.length > 0 ? timeToMin(times[times.length - 1]) + 240 : 480
    // 避开重复时间点
    let guard = 0
    while (times.indexOf(minToTime(t)) >= 0 && guard < 20) {
      t = t + 60
      guard++
    }
    if (t > 1435) {
      this.tx = '时间已排到 23:55，请到手机端调整'
      this.toastOn = true
      const that2 = this
      setTimeout(function () { that2.toastOn = false }, 1600)
      return
    }
    times.push(minToTime(t))
    plan.times = times
    this.save()
    this.render()
    this.tx = '已加到 ' + times.length + ' 次'
    this.toastOn = true
    const that3 = this
    setTimeout(function () { that3.toastOn = false }, 1400)
    vibrator.vibrate({ mode: 'short' })
  },

  delTime(index) {
    const plan = this.rawPlans[index]
    if (!plan) {
      return
    }
    const times = plan.times || []
    if (times.length <= 1) {
      return
    }
    const removed = times.pop()
    plan.times = times
    this.save()
    this.render()
    this.tip('已减一次：' + removed)
  },

  plus0() { this.addTime(0) },
  plus1() { this.addTime(1) },
  plus2() { this.addTime(2) },
  minus0() { this.delTime(0) },
  minus1() { this.delTime(1) },
  minus2() { this.delTime(2) },

  resetAll() {
    this.rawPlans = JSON.parse(JSON.stringify(DEFAULT_PLANS))
    this.save()
    this.render()
    vibrator.vibrate({ mode: 'short' })
  }
}
</script>
